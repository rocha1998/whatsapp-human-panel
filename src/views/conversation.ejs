<!doctype html><html lang="pt-br"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/style.css"><title>Conversa</title></head>
<body><header><a href="/">← Conversas</a><strong><%= conv.display_name || conv.wa_id %> · <%= conv.client_name %></strong><form method="post" action="/conversation/<%= conv.id %>/close"><button class="ghost">Encerrar</button></form></header>
<main class="chat-wrap"><% if (error) { %><div class="error"><%= error %></div><% } %><section class="chat"><% messages.forEach(m => { %><div class="bubble <%= m.direction==='out'?'out':'in' %>"><div><%= m.body %></div><small><%= new Date(m.created_at).toLocaleString('pt-BR') %> <%= m.status ? '· '+m.status : '' %></small></div><% }) %></section><form class="reply" method="post" action="/conversation/<%= conv.id %>/reply"><textarea name="text" placeholder="Digite sua resposta..." required></textarea><button>Enviar</button></form></main></body></html>
