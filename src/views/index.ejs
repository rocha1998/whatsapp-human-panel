<!doctype html><html lang="pt-br"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/style.css"><title>Conversas</title></head>
<body><header><strong>WhatsApp Atendimento</strong><nav><a href="/">Conversas</a><a href="/clients">Clientes</a><form method="post" action="/logout"><button class="ghost">Sair</button></form></nav></header>
<main><section class="card"><form class="filters" method="get"><select name="client_id"><option value="">Todos os clientes</option><% clients.forEach(c => { %><option value="<%= c.id %>" <%= String(filters.client_id||'')===String(c.id)?'selected':'' %>><%= c.name %></option><% }) %></select><input name="q" placeholder="Buscar nome ou telefone" value="<%= filters.q||'' %>"><button>Filtrar</button></form></section>
<section class="list"><% if (!conversations.length) { %><div class="card">Nenhuma conversa ainda.</div><% } %><% conversations.forEach(c => { %><a class="conversation card" href="/conversation/<%= c.id %>"><div><strong><%= c.display_name || c.wa_id %></strong><small><%= c.client_name %> · <%= c.wa_id %></small><p><%= c.last_body || '' %></p></div><div class="right"><small><%= new Date(c.last_message_at).toLocaleString('pt-BR') %></small><% if (c.unread_count) { %><span class="badge"><%= c.unread_count %></span><% } %></div></a><% }) %></section></main></body></html>
