<!doctype html><html lang="pt-br"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/style.css"><title>Clientes</title></head>
<body><header><strong>Clientes</strong><nav><a href="/">Conversas</a><a href="/clients">Clientes</a></nav></header><main><section class="card"><h2>Adicionar cliente</h2><p>Cadastre os dados do número conectado à WhatsApp Cloud API. O token é criptografado antes de ir ao banco.</p><% if (error) { %><div class="error"><%= error %></div><% } %><form class="grid" method="post" action="/clients"><label>Nome<input name="name" required></label><label>Phone Number ID<input name="phone_number_id" required></label><label>WABA ID<input name="waba_id"></label><label>Access Token<input type="password" name="access_token" required></label><button>Salvar cliente</button></form></section><section class="card"><h2>Clientes cadastrados</h2><table><tr><th>Nome</th><th>Phone Number ID</th><th>WABA</th><th>Status</th></tr><% clients.forEach(c=>{ %><tr><td><%= c.name %></td><td><%= c.phone_number_id %></td><td><%= c.waba_id||'-' %></td><td><%= c.status %></td></tr><% }) %></table></section></main></body></html>
